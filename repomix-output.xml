    width: 132px;

    display: flex;
    flex-direction: column;
    gap: 0;

    padding: 6px 0;

    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 7px;

    background-color: #34384c;

    box-shadow: 0 12px 28px rgba(10, 11, 18, 0.35);

    overflow: hidden;
}

.scrapButton,
.exchangeButton {
    width: 100%;
    min-height: 44px;
    padding: 0 14px;

    border: 0;
    border-radius: 0;

    color: #ffffff;

    font-family: inherit;
    font-size: 12px;
    font-weight: 500;
    text-align: left;

    background-color: transparent;

    cursor: pointer;
}

.scrapButton:hover,
.exchangeButton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

/* =========================
   상세 내용
========================= */

.detailCard {
    min-width: 0;
    padding: 0;

    border-radius: 0;
    background-color: #101017;

    box-sizing: border-box;
}

.section {
    padding: 28px 32px;

    border-bottom: 3px solid #272b3d;
}

.section:last-child {
    border-bottom: 0;
}

.sectionTitle {
    margin: 0 0 14px;

    color: #888e9f;

    font-size: 12px;
    font-weight: 500;
    line-height: 1.5;
}

.introduction {
    margin: 0;

    color: #f5f6f8;

    font-size: 14px;
    font-weight: 400;
    line-height: 1.7;

    white-space: pre-line;
    word-break: keep-all;
}

/* =========================
   관심 분야 / 스킬
========================= */

.tagList {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.tag {
    max-width: 100%;
    min-height: 32px;
    padding: 6px 11px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border-radius: 7px;
    background-color: #363b51;
    color: #dce0eb;

    font-size: 12px;
    font-weight: 500;
    line-height: 18px;

    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;

    box-sizing: border-box;
}

/* =========================
   링크
========================= */

.linkList {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 26px;
}

.linkItem {
    width: 54px;

    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 9px;

    color: #858b9d;
    text-decoration: none;
}

.linkCircle {
    width: 52px;
    height: 52px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;
    background-color: #353a50;
    color: #d9dde8;

    transition:
        transform 0.18s ease,
        background-color 0.18s ease,
        color 0.18s ease;
}

.linkIcon {
    width: 24px;
    height: 24px;
}

.linkLabel {
    width: 100%;

    overflow: hidden;

    color: #74798a;

    font-size: 10px;
    font-weight: 400;
    line-height: 1.4;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.linkItem:hover .linkCircle {
    background-color: #454b64;
    color: #ffffff;

    transform: translateY(-2px);
}

.linkItem:hover .linkLabel {
    color: #ffffff;
}

.linkItem:focus-visible {
    border-radius: 8px;
    outline: 2px solid #afd8f8;
    outline-offset: 4px;
}

/* =========================
   경험
========================= */

.experienceGrid {
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.experienceCard {
    min-width: 0;

    overflow: hidden;

    border: 0;
    border-radius: 7px;
    background-color: #363b51;

    box-sizing: border-box;
}

.experienceCard:hover {
    background-color: #3c4259;
}

.expandedExperienceCard {
    background-color: #3c4259;
}

.experienceToggle {
    position: relative;

    width: 100%;
    padding: 18px 44px 18px 18px;

    display: block;

    border: 0;
    background: transparent;
    color: inherit;

    font: inherit;
    text-align: left;

    cursor: pointer;
    box-sizing: border-box;
}

.experienceToggle:focus-visible {
    outline: 2px solid #afd8f8;
    outline-offset: -2px;
}

.experienceTitleRow {
    min-width: 0;

    display: flex;
    align-items: center;
    gap: 8px;

    margin-bottom: 8px;
}

.representativeBadge {
    padding: 5px 9px;

    flex-shrink: 0;

    border-radius: 4px;
    background-color: #50566d;
    color: #f5f6f8;

    font-size: 10px;
    font-weight: 600;
    line-height: 1.3;
}

.experienceTitle {
    min-width: 0;

    overflow: hidden;

    color: #ffffff;

    font-size: 14px;
    font-weight: 700;
    line-height: 1.5;

    text-overflow: ellipsis;
    white-space: nowrap;
}

.experienceSummary {
    margin: 0;

    display: -webkit-box;
    overflow: hidden;

    color: #aeb3c2;

    font-size: 12px;
    font-weight: 400;
    line-height: 1.65;

    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
}

.expandIcon {
    position: absolute;
    top: 18px;
    right: 18px;

    color: #aeb3c2;

    font-size: 16px;
    line-height: 1;
}

.experienceDetail {
    padding: 0 18px 18px;

    border-top: 1px solid #50566e;
}

.experienceDescription {
    margin: 16px 0 0;

    color: #c8ccd7;

    font-size: 12px;
    font-weight: 400;
    line-height: 1.7;

    white-space: pre-line;
}

.experienceLink {
    width: fit-content;
    max-width: 100%;
    margin-top: 14px;

    display: flex;
    align-items: center;
    gap: 8px;

    color: #8f96aa;

    font-size: 11px;
    font-weight: 500;
    text-decoration: none;
}

.experienceLink:hover {
    color: #ffffff;
}

/* =========================
   빈 데이터
========================= */

.emptyText,
.emptyDrawerText {
    margin: 0;

    color: #74798a;

    font-size: 12px;
    line-height: 1.6;
}

/* =========================
   스크랩 모달
========================= */

.modalBackdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;

    padding: 20px;

    display: flex;
    align-items: center;
    justify-content: center;

    background-color: rgba(8, 8, 13, 0.76);
    backdrop-filter: blur(6px);

    box-sizing: border-box;
}

.scrapModal {
    width: min(500px, 100%);
    max-height: 82vh;
    padding: 30px;

    overflow-y: auto;

    border: 1px solid #41465c;
    border-radius: 12px;
    background-color: #222435;
    color: #ffffff;

    box-sizing: border-box;
}

.modalHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 28px;
}

.modalHeader h2 {
    margin: 0;

    color: #ffffff;

    font-size: 22px;
    font-weight: 700;
}

.closeButton {
    width: 32px;
    height: 32px;
    padding: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 0;
    background: transparent;
    color: #ffffff;

    font-size: 30px;
    line-height: 1;

    cursor: pointer;
}

.closeButton:hover {
    color: #afd8f8;
}

.scrapSummary {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 18px;
}

.scrapSummary > span {
    color: #777d91;

    font-size: 14px;
    font-weight: 600;
}

.addDrawerButton {
    padding: 8px 0;

    border: 0;
    background: transparent;
    color: #dce0eb;

    font-family: inherit;
    font-size: 14px;
    font-weight: 700;

    cursor: pointer;
}

.addDrawerButton:hover {
    color: #afd8f8;
}

.addDrawerForm {
    margin-bottom: 18px;
    padding: 16px;

    border: 1px solid #4b516b;
    border-radius: 8px;
    background-color: #292c40;
}

.addDrawerInputRow {
    position: relative;
}

.addDrawerInputRow input {
    width: 100%;
    height: 44px;
    padding: 0 54px 0 14px;

    border: 1px solid transparent;
    border-radius: 6px;
    outline: none;

    background-color: #363b51;
    color: #ffffff;

    font-family: inherit;
    font-size: 13px;

    box-sizing: border-box;
}

.addDrawerInputRow input::placeholder {
    color: #777d91;
}

.addDrawerInputRow input:focus {
    border-color: #afd8f8;
}

.addDrawerInputRow span {
    position: absolute;
    top: 50%;
    right: 12px;

    color: #8f96aa;

    font-size: 11px;

    transform: translateY(-50%);
}

.addDrawerActions {
    margin-top: 12px;

    display: flex;
    justify-content: flex-end;
    gap: 8px;
}

.cancelDrawerButton,
.createDrawerButton {
    min-width: 68px;
    height: 34px;
    padding: 0 12px;

    border: 0;
    border-radius: 5px;

    font-family: inherit;
    font-size: 12px;
    font-weight: 600;

    cursor: pointer;
}

.cancelDrawerButton {
    background-color: #363b51;
    color: #dce0eb;
}

.createDrawerButton {
    background-color: #afd8f8;
    color: #171925;
}

.createDrawerButton:disabled {
    background-color: #4b5065;
    color: #858b9e;

    cursor: not-allowed;
}

.scrapDrawerList {
    max-height: 260px;

    overflow-y: auto;

    display: flex;
    flex-direction: column;
}

.scrapDrawerButton {
    width: 100%;
    min-height: 58px;
    padding: 0;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border: 0;
    background: transparent;
    color: #ffffff;

    font-family: inherit;
    text-align: left;

    cursor: pointer;
}

.scrapDrawerName {
    min-width: 0;

    overflow: hidden;

    color: #dce0eb;

    font-size: 16px;
    font-weight: 500;

    text-overflow: ellipsis;
    white-space: nowrap;
}

.scrapStatusIcon {
    width: 32px;
    height: 32px;
    margin-right: 8px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 2px solid #ffffff;
    border-radius: 50%;

    background-color: transparent;
    color: #ffffff;

    font-size: 22px;
    line-height: 1;

    box-sizing: border-box;
}

.selectedStatusIcon {
    background-color: #ffffff;
    color: #222435;

    font-size: 19px;
    font-weight: 700;
}

.emptyDrawerText {
    margin: 24px 0;

    text-align: center;
}

.saveButton {
    width: 100%;
    height: 50px;
    margin-top: 26px;

    border: 0;
    border-radius: 7px;

    background-color: #afd8f8;
    color: #171925;

    font-family: inherit;
    font-size: 15px;
    font-weight: 700;

    cursor: pointer;
}

.saveButton:hover {
    background-color: #c4e4fc;
}

.saveButton:disabled {
    opacity: 0.65;
    cursor: not-allowed;
}

/* =========================
   로딩 / 오류
========================= */

.notFound {
    min-height: calc(100vh - 64px);

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;

    background-color: #101017;
    color: #ffffff;
}

.notFound p {
    margin: 0;
}

.notFound button {
    padding: 10px 16px;

    border: 0;
    border-radius: 6px;

    background-color: #afd8f8;
    color: #171925;

    font-family: inherit;
    cursor: pointer;
}


/* =========================
   상단 뒤로가기 / 더보기
========================= */

.backButton {
    position: absolute;
    z-index: 5;
    top: 18px;
    left: 16px;

    width: 40px;
    height: 40px;
    padding: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 0;
    border-radius: 50%;

    background-color: rgba(20, 23, 35, 0.18);
    color: #ffffff;

    font-family: inherit;
    font-size: 34px;
    font-weight: 300;
    line-height: 1;

    cursor: pointer;
}

.backButton:hover {
    background-color: rgba(20, 23, 35, 0.32);
}

.backButton:focus-visible,
.moreButton:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 2px;
}

.actionMenuArea {
    position: absolute;
    z-index: 10;
    top: 18px;
    right: 16px;
}

.moreButton {
    width: 40px;
    height: 40px;
    padding: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 0;
    border-radius: 50%;

    background-color: rgba(20, 23, 35, 0.18);
    color: #ffffff;

    font-family: inherit;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 2px;

    cursor: pointer;
}

.moreButton:hover {
    background-color: rgba(20, 23, 35, 0.32);
}

.actionMenuArea .summaryActions {
    top: 46px;
    right: 0;
}

.experienceContent {
    padding: 18px;
}

.scrapError {
    margin: 12px 0;

    color: #ff8c92;

    font-size: 13px;
    line-height: 1.5;
}

/* =========================
   태블릿 이상
========================= */

@media (min-width: 769px) {
    .page {
        padding: 48px 0 80px;
    }

    .layout {
        border-radius: 14px;

        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.3);

        overflow: hidden;
    }

    .summaryCard {
        min-height: 330px;
        padding: 130px 48px 32px;
    }

    .avatar,
    .avatarPlaceholder {
        width: 72px;
        height: 72px;
    }

    .section {
        padding: 34px 48px;
    }

    .experienceGrid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .summaryActions {
        top: 96px;
        right: 32px;
    }
}



/* =========================
   모바일
========================= */

@media (max-width: 768px) {
    .page {
        min-height: 100vh;
        padding-bottom: 0;
    }

    .layout {
        width: 100%;
    }

    .summaryCard {
        min-height: 306px;
        padding: 112px 16px 20px;
    }

    .avatar,
    .avatarPlaceholder {
        width: 62px;
        height: 62px;
        margin-bottom: 18px;
    }

    .name {
        font-size: 21px;
    }

    .summaryActions {
        top: 88px;
        right: 14px;
    }

    .section {
        padding: 26px 16px;
    }

    .linkList {
        gap: 26px;
    }

    .modalBackdrop {
        padding: 0;

        align-items: flex-end;
    }

    .scrapModal {
        width: 100%;
        max-height: 82vh;
        padding: 26px 20px 34px;

        border-radius: 16px 16px 0 0;
    }

    .modalHeader h2 {
        font-size: 20px;
    }

    .saveButton {
        position: sticky;
        bottom: 0;
    }
}

@media (max-width: 420px) {
    .summaryCard {
        padding-right: 16px;
        padding-left: 16px;
    }

    .section {
        padding-right: 16px;
        padding-left: 16px;
    }

    .linkList {
        justify-content: flex-start;
        gap: 20px;
    }

    .linkItem {
        width: 50px;
    }

    .linkCircle {
        width: 50px;
        height: 50px;
    }

    .experienceToggle {
        padding: 16px 42px 16px 16px;
    }

    .experienceDetail {
        padding: 0 16px 16px;
    }
}
