            {activeSection ===
                "account" &&
                renderAccount()}
            </div>
        </section>

        {isLeaveModalOpen && (
            <div
            className={
                styles.modalBackdrop
            }
            role="presentation"
            onMouseDown={
                handleContinueEditing
            }
            >
            <section
                className={
                styles.leaveModal
                }
                role="dialog"
                aria-modal="true"
                aria-labelledby="leave-modal-title"
                onMouseDown={(
                event,
                ) =>
                event.stopPropagation()
                }
            >
                <h2 id="leave-modal-title">
                변경 내용을
                삭제하시겠어요?
                </h2>

                <p>
                지금 돌아가면 변경
                내용이 삭제됩니다.
                </p>

                <div
                className={
                    styles.modalActions
                }
                >
                <button
                    type="button"
                    className={
                    styles.continueButton
                    }
                    onClick={
                    handleContinueEditing
                    }
                >
                    수정 계속하기
                </button>

                <button
                    type="button"
                    className={
                    styles.discardButton
                    }
                    onClick={
                    handleDiscardChanges
                    }
                >
                    변경 사항 삭제
                </button>
                </div>
            </section>
            </div>
        )}

        {isWithdrawModalOpen && (
            <div
            className={
                styles.modalBackdrop
            }
            role="presentation"
            onMouseDown={() =>
                !isWithdrawing &&
                setIsWithdrawModalOpen(
                false,
                )
            }
            >
            <section
                className={
                styles.leaveModal
                }
                role="dialog"
                aria-modal="true"
                aria-labelledby="withdraw-modal-title"
                onMouseDown={(
                event,
                ) =>
                event.stopPropagation()
                }
            >
                <h2 id="withdraw-modal-title">
                정말 탈퇴하시겠어요?
                </h2>

                <p>
                탈퇴 후에는 계정
                정보를 복구할 수
                없습니다.
                </p>

                <div
                className={
                    styles.modalActions
                }
                >
                <button
                    type="button"
                    className={
                    styles.continueButton
                    }
                    onClick={() =>
                    setIsWithdrawModalOpen(
                        false,
                    )
                    }
                    disabled={
                    isWithdrawing
                    }
                >
                    취소
                </button>

                <button
                    type="button"
                    className={
                    styles.withdrawConfirmButton
                    }
                    onClick={
                    handleWithdraw
                    }
                    disabled={
                    isWithdrawing
                    }
                >
                    {isWithdrawing
                    ? "탈퇴 중..."
                    : "탈퇴하기"}
                </button>
                </div>
            </section>
            </div>
        )}
        </main>
    );
    };

    export default Settings;
