    border-radius: 50%;

    color: #ffffff;

    font-size: 26px;
    line-height: 1;

    box-sizing: border-box;
}

.selectedIcon {
    border-color: #ffffff;
    background-color: #ffffff;
    color: #222435;

    font-size: 20px;
    font-weight: 800;
}

.saveScrapButton {
    width: 100%;
    height: 52px;
    margin-top: 34px;

    border: 0;
    border-radius: 9px;

    background-color: #afd8f8;
    color: #222435;

    font-size: 17px;
    font-weight: 700;

    cursor: pointer;
}

/* =========================
새 서랍 생성
========================= */

.createDrawerForm {
    display: flex;
    flex-direction: column;
}

.createDrawerInputHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 8px;
}

.createDrawerInputHeader label,
.createDrawerInputHeader span {
    color: #9da3b6;
    font-size: 13px;
}

.createDrawerForm input {
    width: 100%;
    height: 46px;
    padding: 0 14px;

    border: 1px solid transparent;
    border-radius: 7px;
    outline: none;

    background-color: #34394f;
    color: #ffffff;

    font-family: inherit;
    font-size: 14px;

    box-sizing: border-box;
}

.createDrawerForm input::placeholder {
    color: #73798d;
}

.createDrawerForm input:focus {
    border-color: #afd8f8;
}

.createDrawerActions {
    margin-top: 80px;

    display: flex;
    align-items: center;
    gap: 10px;
}

.cancelCreateButton,
.createDrawerButton {
    height: 50px;

    border: 0;
    border-radius: 8px;

    font-family: inherit;
    font-size: 15px;
    font-weight: 700;

    cursor: pointer;
}

.cancelCreateButton {
    width: 100px;

    background-color: #363b51;
    color: #ffffff;
}

.createDrawerButton {
    flex: 1;

    background-color: #afd8f8;
    color: #222435;
}

.createDrawerButton:disabled {
    background-color: #596077;
    color: #9298aa;

    cursor: not-allowed;
}

/* =========================
태블릿
========================= */

@media (max-width: 1024px) {
    .pageHeader {
        padding: 44px 48px 0;
    }

    .leftArrow {
        left: 28px;
    }

    .rightArrow {
        right: 28px;
    }

    .indicator {
        width: min(380px, 68%);
    }
}

/* =========================
모바일
========================= */

@media (max-width: 768px) {
    .container {
        min-height: 100vh;
    }

    .pageHeader {
        padding: 28px 20px 0;
    }

    .backButton {
        gap: 8px;

        font-size: 16px;
    }

    .backButton svg {
        width: 18px;
        height: 18px;
    }

    .carouselSection {
        margin-top: 10px;
    }

    .swiper {
        padding: 36px 0 28px;
        overflow: visible;
    }

    .slide {
        width: min(76vw, 320px);
    }

    .slide > button {
        opacity: 0.14;
        filter: blur(2px);
        transform: scale(0.82);
    }

    .slide:not(
            :global(.swiper-slide-active),
            :global(.swiper-slide-prev),
            :global(.swiper-slide-next)
        ) > button {
            opacity: 0.2;
            filter: blur(2px);
            transform: scale(0.78);
    }

    .slide:global(.swiper-slide-prev) > button,
    .slide:global(.swiper-slide-next) > button {
        opacity: 0.45;
        filter: blur(0.8px);
    }

    .slide:global(.swiper-slide-active) > button {
        opacity: 1;
        filter: blur(0);
        transform: scale(1);
    }

    .arrowButton {
        display: none;
    }

    .actionArea {
        margin: 4px 0 20px;
    }

    .scrapButton {
        min-width: 104px;
        height: 40px;
        padding: 0 17px;

        font-size: 13px;
    }

    .scrapIcon {
        width: 18px;
        height: 18px;
    }

    .indicatorContainer {
        display: none;
    }

    .scrapSheet {
        max-width: none;
        min-height: 56vh;
        padding: 28px 24px 24px;

        border-radius: 16px 16px 0 0;
    }

    .scrapSheetHeader h2 {
        font-size: 21px;
    }

    .collectionItem {
        min-height: 64px;

        font-size: 16px;
    }

    .saveScrapButton {
        margin-top: 38px;
    }

    .createDrawerActions {
        margin-top: 100px;
    }
}
