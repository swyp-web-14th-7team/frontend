                                            }
                                        >
                                            <span>
                                                {draft.title ||
                                                    "작성 중인 카드"}
                                            </span>

                                            <time>
                                                {draft.updatedAt
                                                    ? new Date(
                                                          draft.updatedAt,
                                                      ).toLocaleString(
                                                          "ko-KR",
                                                      )
                                                    : "저장 시간 없음"}
                                            </time>
                                        </button>
                                    ),
                                )}
                            </div>
                        )}

                        <button
                            type="button"
                            className={
                                styles.continueButton
                            }
                            disabled={
                                !selectedDraftId
                            }
                            onClick={
                                handleContinueDraft
                            }
                        >
                            이어쓰기
                        </button>
                    </section>
                </div>
            )}
        </main>
    );
};

