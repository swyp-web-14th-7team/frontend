<file path="src/components/exchange/MyCardSelector.module.css">
.selector {
    width: 100%;
    min-height: 0;

    flex: 1;

    display: flex;
    flex-direction: column;
}

.carousel {
    width: 100%;
    height: 470px;
    min-height: 470px;
    padding:
        0
        calc((100% - 282px) / 2)
        12px;

    flex: none;

    display: flex;
    align-items: flex-start;
    gap: 32px;

    overflow-x: auto;
    overflow-y: visible;

    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scroll-padding-inline:
        calc((100% - 282px) / 2);
    overscroll-behavior-x: contain;
    scrollbar-width: none;

    box-sizing: border-box;
}

.carousel::-webkit-scrollbar {
    display: none;
}

.cardOption {
    width: 282px;
    min-width: 282px;

    display: flex;
    flex-direction: column;
    align-items: center;

    overflow: visible;

    scroll-snap-align: center;
}

.cardWrapper {
    width: 282px;

    flex-shrink: 0;
    overflow: hidden;

    border: 0;
    border-radius: 12px;

    transition:
        opacity 0.2s ease,
        filter 0.2s ease;

    box-sizing: border-box;
}

.cardWrapper > button,
.cardWrapper article {
    width: 100%;
}

.selectedCard {
    opacity: 1;
    filter: none;
}

.unselectedCard {
    opacity: 0.34;
    filter: saturate(0.75);
}

.unselectedCard:hover,
.unselectedCard:focus-within {
    opacity: 0.58;
}

.cardMeta {
    min-height: 28px;
    margin-top: 12px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
}

.badge {
    min-width: 40px;
    height: 28px;
    padding: 0 10px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    border-radius: 6px;

    font-size: 12px;
    font-weight: 600;

    box-sizing: border-box;
}

.publicBadge {
    background-color: #afd8f8;
    color: #222435;
}

.privateBadge {
    background-color: #4b516b;
    color: #ffffff;
}

.defaultBadge {
    background-color: #303347;
    color: #ffffff;
}

.pagination {
    min-height: 10px;
    margin: 6px 0 14px;

    flex-shrink: 0;

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
}

.dot {
    width: 8px;
    height: 8px;
    padding: 0;

    border: 0;
    border-radius: 50%;

    background-color: #555b70;

    cursor: pointer;
}

.dot:hover {
    background-color: #7c849d;
}

.activeDot {
    width: 10px;
    height: 10px;

    background-color: #afd8f8;
}

.empty {
    width: 100%;
    min-height: 470px;

    flex: 1;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px dashed #4b516b;
    border-radius: 8px;
    color: #888ea2;

    font-size: 14px;

    box-sizing: border-box;
}

@media (max-width: 768px) {
    .carousel {
        height: 430px;
        min-height: 430px;
        padding:
            0
            calc((100% - 242px) / 2)
            12px;

        gap: 24px;

        scroll-padding-inline:
            calc((100% - 242px) / 2);
    }

    .cardOption,
    .cardWrapper {
        width: 242px;
        min-width: 242px;
    }
}

@media (max-width: 420px) {
    .carousel {
        height: 410px;
        min-height: 410px;
        padding:
            0
            calc((100% - 226px) / 2)
            12px;

        gap: 20px;

        scroll-padding-inline:
            calc((100% - 226px) / 2);
    }

    .cardOption,
    .cardWrapper {
        width: 226px;
        min-width: 226px;
    }
}
