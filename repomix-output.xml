                                                >
                                                    {isSelected
                                                        ? "✓"
                                                        : "+"}
                                                </span>
                                            </button>
                                        );
                                    },
                                )
                            ) : (
                                <p
                                    className={
                                        styles.emptyDrawerText
                                    }
                                >
                                    생성된 서랍이
                                    없습니다. 서랍을
                                    먼저 추가해 주세요.
                                </p>
                            )}
                        </div>

                        <button
                            type="button"
                            className={
                                styles.saveButton
                            }
                            onClick={
                                handleScrapSave
                            }
                            disabled={
                                isSavingScrap
                            }
                        >
                            {isSavingScrap
                                ? "저장 중..."
                                : "저장"}
                        </button>
                    </section>
                </div>
            )}

            {isExchangeModalOpen && (
                <CardExchangeModal
                    receiver={
                        profile
                    }
                    onClose={
                        handleCloseExchangeModal
                    }
                    onSend={
                        handleSendExchange
                    }
                />
            )}
        </main>
    );
};

export default ProfileDetail;
