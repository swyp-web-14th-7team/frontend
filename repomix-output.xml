        );
        };

    const renderAccount =
        () => {
        return (
            <>
            <div
                className={
                styles.contentHeader
                }
            >
                <h1>
                계정 관리
                </h1>

                <p>
                계정과 관련된 설정을
                관리합니다.
                </p>
            </div>

            {error && (
                <p
                className={
                    styles.error
                }
                role="alert"
                >
                {error}
                </p>
            )}

            <div
                className={
                styles.dangerSection
                }
            >
                <div>
                <strong>
                    회원 탈퇴
                </strong>

                <p>
                    탈퇴하면 계정과
                    관련된 정보가
                    삭제되며 되돌릴 수
                    없습니다.
                </p>
                </div>

                <button
                type="button"
                onClick={() =>
                    setIsWithdrawModalOpen(
