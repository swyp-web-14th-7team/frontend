    }
}

@media (max-width: 420px) {
    .ownerActions {
        left: 16px;
        right: 16px;

        justify-content: flex-end;
    }

    .ownerActions button {
        padding: 0 9px;
    }

    .settingRow {
        gap: 12px;
    }

    .settingRow select {
        min-width: 130px;
    }

    .deleteActions {
        grid-template-columns: 1fr;
    }
}
