                        groupId:
                            selectedDrawerId,
                    });
                } else if (
                    savedProfile?.collectionId &&
                    !selectedDrawerId
                ) {
                    await deleteCollection(
                        savedProfile.collectionId,
                    );
                } else if (
                    savedProfile?.collectionId &&
                    selectedDrawerId &&
                    String(
                        savedDrawer.id,
                    ) !==
                        String(
                            selectedDrawerId,
                        )
                ) {
                    await moveCollection(
                        savedProfile.collectionId,
                        selectedDrawerId,
