) => {
    return apiRequest(
        `/collection-groups/${groupId}`,
        {
            method: "PATCH",
            body: JSON.stringify({
                name: name.trim(),
            }),
        },
    );
};

/*
 * 스크랩 서랍 삭제
 * DELETE /collection-groups/{groupId}
 *
 * 서랍에 들어 있는 스크랩도 함께 삭제된다.
