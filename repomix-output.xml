<file path="src/pages/ProfileCarousel/ProfileCarouselPage.module.css">
.container {
    width: 100%;
    min-height: calc(100vh - 80px);

    overflow: hidden;

    box-sizing: border-box;
}

/* =========================
상단
========================= */

.pageHeader {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 56px 88px 0;

    box-sizing: border-box;
}

.backButton {
    min-height: 32px;
    padding: 0;

    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;

    border: 0;
    background-color: transparent;
    color: #ffffff;

    font-family: inherit;
    font-size: 18px;
    font-weight: 600;
    line-height: 150%;

    cursor: pointer;

    transition:
        opacity 0.2s ease,
        transform 0.2s ease;
}

.backButton svg {
    display: block;
    flex-shrink: 0;
}

.backButton:hover {
    opacity: 0.75;
    transform: translateX(-2px);
}

.backButton:active {
    opacity: 0.6;
    transform: translateX(-4px);
}

.backButton:focus-visible {
    border-radius: 4px;
    outline: 2px solid #ffffff;
    outline-offset: 5px;
}

/* =========================
캐러셀
========================= */

.carouselSection {
    width: 100%;
    margin-top: 22px;
}

.carouselArea {
    position: relative;

    width: 100%;

    overflow: hidden;
}

.swiper {
    width: 100%;
    padding: 58px 0 32px;

    overflow: visible;

    box-sizing: border-box;
}

.slide {
    width: 282px;
    height: auto;

    display: flex;
    align-items: center;
    justify-content: center;
}

.slide > button {
    width: 100%;
    margin: 0 auto;

    opacity: 0.18;
    filter: blur(2.5px);
    transform: scale(0.78);

    transition:
        opacity 0.45s ease,
        transform 0.45s ease,
        filter 0.45s ease;
}

.slide:global(.swiper-slide-active) {
    z-index: 10;
}

.slide:global(.swiper-slide-active) > button {
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
}

.slide:global(.swiper-slide-active) article {
    box-shadow:
        0 24px 50px rgba(0, 0, 0, 0.38);
}

.slide:global(.swiper-slide-prev),
.slide:global(.swiper-slide-next) {
    z-index: 5;
}

.slide:global(.swiper-slide-prev) > button,
.slide:global(.swiper-slide-next) > button {
    opacity: 0.58;
    filter: blur(0.7px);
}

.slide:global(.swiper-slide-prev) > button {
    transform:
        translateX(-12px)
        scale(0.9);
}

.slide:global(.swiper-slide-next) > button {
    transform:
        translateX(12px)
        scale(0.9);
}

/* =========================
화살표
========================= */

.arrowButton {
    position: absolute;
    top: 50%;
    z-index: 30;

    width: 48px;
    height: 48px;
    padding: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 1px solid
        rgba(255, 255, 255, 0.14);
    border-radius: 50%;

    background-color: rgba(30, 34, 50, 0.9);
    color: #ffffff;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    backdrop-filter: blur(8px);
    cursor: pointer;

    transform:
        translateY(-50%)
        scale(0.9);

    transition:
        opacity 0.25s ease,
        visibility 0.25s ease,
        transform 0.25s ease,
        background-color 0.2s ease;
}

.carouselArea:hover
.arrowButton:not(:disabled) {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform:
        translateY(-50%)
        scale(1);
}

.arrowButton:focus-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    outline: 2px solid #ffffff;
    outline-offset: 3px;

    transform:
        translateY(-50%)
        scale(1);
}

.arrowButton:hover {
    background-color: #343a54;

    transform:
        translateY(-50%)
        scale(1.08);
}

.arrowButton:disabled {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}

.leftArrow {
    left: 40px;
}

.rightArrow {
    right: 40px;
}

/* =========================
스크랩 버튼
========================= */

.actionArea {
    width: 100%;
    margin: 8px 0 24px;

    display: flex;
    align-items: center;
    justify-content: center;
}

.scrapButton {
    min-width: 112px;
    height: 44px;
    padding: 0 20px;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;

    border: 1px solid
        rgba(255, 255, 255, 0.16);
    border-radius: 999px;

    background-color: #1e2232;
    color: #ffffff;

    font-family: inherit;
    font-size: 14px;
    font-weight: 600;

    cursor: pointer;

    transition:
        background-color 0.2s ease,
        border-color 0.2s ease,
        transform 0.2s ease;
}

.scrapIcon {
    display: block;
    width: 20px;
    height: 20px;

    flex-shrink: 0;
}

.scrapButton:hover {
    border-color:
        rgba(255, 255, 255, 0.28);

    background-color: #343a54;

    transform: translateY(-2px);
}

.scrapButton.scrapped {
    border-color: #525dff;
    background-color: #525dff;
}

.emptyMessage {
    margin: 120px auto 0;

    color: #ffffff;
    font-size: 16px;
    text-align: center;
}

/* =========================
인디케이터
========================= */

.indicatorContainer {
    width: 100%;
    padding-bottom: 40px;

    display: flex;
    justify-content: center;
}

.indicator {
    position: relative;

    width: 420px;
    height: 20px;

    cursor: grab;
    touch-action: none;
    user-select: none;
}

.indicator::before {
    position: absolute;
    top: 50%;
    left: 0;

    width: 100%;
    height: 4px;

    border-radius: 999px;
    background-color: #252a40;

    content: "";
    transform: translateY(-50%);
}

.indicatorThumb {
    position: absolute;
    top: 50%;
    left: calc(
        var(--indicator-progress) *
        (100% - 20px)
    );
    z-index: 1;

    width: 20px;
    height: 5px;

    border-radius: 999px;
    background-color: #f5f5f7;

    pointer-events: none;

    transform: translateY(-50%);

    box-shadow:
        0 0 4px rgba(255, 255, 255, 0.45),
        0 0 12px rgba(211, 217, 255, 0.38),
        0 0 28px rgba(133, 146, 213, 0.28);

    transition: left 0.18s ease-out;
}

/* =========================
스크랩 바텀시트
========================= */

.scrapSheetBackdrop {
    position: fixed;
    inset: 0;
    z-index: 1000;

    display: flex;
    align-items: flex-end;
    justify-content: center;

    background-color: rgba(10, 10, 16, 0.72);
    backdrop-filter: blur(7px);
}

.scrapSheet {
    width: 100%;
    max-width: 640px;
    min-height: 430px;
    padding: 32px 26px 28px;

    border-radius: 20px 20px 0 0;
    background-color: #222435;
    color: #ffffff;

    box-sizing: border-box;
}

.scrapSheetHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 34px;
}

.scrapSheetHeader h2 {
    margin: 0;

    font-size: 24px;
    font-weight: 700;
}

.sheetCloseButton {
    width: 36px;
    height: 36px;
    padding: 0;

    border: 0;
    background: transparent;
    color: #ffffff;

    font-size: 34px;
    font-weight: 300;
    line-height: 1;

    cursor: pointer;
}

.collectionSummary {
    display: flex;
    align-items: center;
    justify-content: space-between;

    margin-bottom: 16px;

    color: #a4a9bb;
    font-size: 15px;
}

.addDrawerButton {
    padding: 4px 0;

    border: 0;
    background: transparent;
    color: #dfe2eb;

    font-family: inherit;
    font-size: 15px;
    font-weight: 600;

    cursor: pointer;
